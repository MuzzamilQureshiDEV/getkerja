# Public URL used for canonical links, sitemap & email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (required to actually receive applications) ─────────────
# Without RESEND_API_KEY, emails are printed to the server console instead of sent.
# Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM="getKerja <careers@yourdomain.my>"

# Inbox that receives every application (CV attached, Reply-To = candidate) and contact message
APPLICATIONS_EMAIL=info@websaura.com

# ── Spam protection (optional) ──────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
