# Public URL used for canonical links, sitemap & email links (defaults to https://getkerja.my in production)
NEXT_PUBLIC_SITE_URL=https://getkerja.my

# ── Email sending (required to receive applications) ──────────────
# Option 1 (recommended): your Hostinger mailbox via SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hr@getkerja.my
SMTP_PASS=            # the hr@getkerja.my mailbox password — set it in Vercel, never commit it

# Option 2: Resend (used only if SMTP_* is not set)
# RESEND_API_KEY=

# Optional overrides (defaults shown)
# EMAIL_FROM="getKerja <hr@getkerja.my>"
# APPLICATIONS_EMAIL=hr@getkerja.my

# ── Spam protection (optional) ──────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
